{
  "name": "markt-dashboard",
  "productName": "Markt-Dashboard",
  "version": "8.23.18",
  "description": "Aktien-Dashboard: Big Tech, Chip-Sektor, Marktüberblick & News – aktualisiert sich selbst",
  "main": "main.js",
  "author": "Wilhelm",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test-channel.js && node test-v6.js",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "de.wilhelm.marktdashboard",
    "productName": "Markt-Dashboard",
    "files": [
      "*.js",
      "!test-*.js",
      "index.html",
      "icon.png",
      "icon.ico",
      "telemetrie.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Markt-Dashboard-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "Markt-Dashboard.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Wilhelm-mbg",
        "repo": "Stock-Dashboard"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
