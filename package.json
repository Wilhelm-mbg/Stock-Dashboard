{
  "name": "markt-dashboard",
  "productName": "Markt-Dashboard",
  "version": "8.37.3",
  "description": "Aktien-Dashboard: Big Tech, Chip-Sektor, Marktüberblick & News – aktualisiert sich selbst",
  "main": "main.js",
  "author": "Wilhelm",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "eslint . && node test-channel.js && node test-v6.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.0",
    "globals": "^15.15.0"
  },
  "build": {
    "appId": "de.wilhelm.marktdashboard",
    "productName": "Markt-Dashboard",
    "files": [
      "*.js",
      "!test-*.js",
      "index.html",
      "icon.png",
      "icon.ico",
      "telemetrie.json",
      "studien/messmaschine/messmaschine.js",
      "studien/messmaschine/messen.js",
      "studien/messmaschine/strategien/wertpapierart.js"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Markt-Dashboard-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Wilhelm-mbg",
        "repo": "Stock-Dashboard"
      }
    ],
    "asarUnpack": [
      "studien/messmaschine/**",
      "quant.js"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
